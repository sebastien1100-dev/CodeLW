// @version:1
include("Deplacement");
include("getCellsToUse");
include("General Usefull");
var allUnits = getAliveAllies()+getAliveEnemies();
//debug(allUnits);
if(getTurn()==1)
{
		SetGetCells();
		FillNeightCells();
		fillOptiTabs(allUnits);
		InitFunctions();
}


FillLeekPos(allUnits);
ReachableAssociative = [];


function InitFunctions()
{	
	getWeaponEffects = function(weapon) { return (ToolEffects[weapon] == null) ? [] : ToolEffects[weapon]; };
	
	getChipEffects = function(chip) { return (ToolEffects[chip] == null) ? [] : ToolEffects[chip]; };
	
	isWeapon = function(tool) {
		return (IsWeaponTab[tool]==null) ? false : IsWeaponTab[tool]; 
	};
	
	getChipCooldown = function(tool) { return getCooldown(tool); };
	
	getChipCost = function(tool) { return (ToolsCost[tool] == null) ?  100000 : ToolsCost[tool]; };
	
	getWeaponCost = function(tool) { return (ToolsCost[tool] == null) ?  100000 : ToolsCost[tool]; };
	
	getWeapons = function(Enemy) { return (AllWeapons[Enemy] == null) ? [] : AllWeapons[Enemy]; };
	
	getChips = function(Enemy) { return (AllChips[Enemy] == null) ? [] : AllChips[Enemy]; };
	
	isObstacle = function(cell) { return MyIsObstacle(cell); };

}


function SetGetCells()
{
	setObstaclesMap();
	//getCellsToUseChipOnCell = function(chip, cell, @Tab) {	MygetCellsToUseChip(chip, cell, @Tab);};
	
	//getCellsToUseWeaponOnCell = function(weapon, cell, @Tab) {	MygetCellsToUseWeapon(weapon, cell, @Tab); };
	
	isObstacle = function(cell) {	return MyIsObstacle(cell);	};
}