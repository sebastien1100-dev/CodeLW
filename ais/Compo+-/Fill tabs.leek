// @version:1
include("Combos");
include("/Generals/Include");
include("Common");
include("Stats");
include("Main");


global UsablesOnEn = []; //liste des armes et puces utilisables a ce tour sur chaque enemis [enemi][tools]
global UsableNonAttack = []; //liste des puces sans degats utilisables [chips]

global WeaponAreaTab = []; //chaque cases ou on peut utilisr les armes sur chaque enemies [enemis][cases]
global ChipAreaTab = []; //chaque cases ou on peut utilisr les chips sur chaque enemies [enemis][cases]


function FillAllTabs(Enem, DispAreaWeap, DispAreaChip)
{
	FillWeaponAreaTab(MyLeek, DispAreaWeap, Enem);
	//DispOpsPercent("Fill Weapons");
	FillChipAreaTab(MyLeek, DispAreaChip, Enem);
	//DispOpsPercent("Fill Chips");
}

function AllUsables(ThisLeek, enemies)
{
	UsablesOnEn = [];
	return UsablesWeapons(ThisLeek, enemies)+UsablesChips(ThisLeek, enemies);
}

function UsablesWeapons( ThisLeek, enemies )
{
	var UsableWeapon = [];
	for(var Weap in getWeapons(ThisLeek))
		for (var en in enemies)
		{
			if(UsablesOnEn[en] == null)
				UsablesOnEn[en] = [];
			
			if(WeaponAreaTab[en][Weap] != [] && !inArray(UsableWeapon, Weap))
			{
				/*if(IsAccessible(ThisLeek, WeaponAreaTab[en][Weap]))
				{*/
					
					push(UsableWeapon, Weap);
					push(UsablesOnEn[en], Weap);
				//}
			}
		}
	return UsableWeapon;
}

function UsablesChips( ThisLeek, enemies )
{
	var UsableChips = [];
	UsableNonAttack = [];
	for(var chip in getChips(ThisLeek))
	{
		var effe = getChipEffects(chip)[0][0];
		if( effe == EFFECT_DAMAGE || effe == EFFECT_POISON )
		{
			for(var en in enemies)
			{
				if(UsablesOnEn[en] == null)
					UsablesOnEn[en] = [];
				
				if(ChipAreaTab[en][chip] != [] && !inArray(UsableChips, chip))
				{
					/*if(IsAccessible(ThisLeek, ChipAreaTab[en][chip]))
					{*/
						push(UsableChips, chip);
						push(UsablesOnEn[en], chip);
					//}
				}
			}
		}
		else
		{
			push(UsableNonAttack, chip);
			//debug("Non attack name " + getChipName(chip));
		}
	}
		
	return UsableChips;
}

function IsAccessible(ThisLeek, ThisArray)
{	//if there is at least one cell in ThisArray in ReachAssoc
	var Cells = [];
	for (var Cell in ThisArray)
	{
		if( ReachableAssociative[ThisLeek][Cell] != null )
			return true;
	}
	return false;
}

function FillCellArrays(UsableTab, Leek)
{	//colore les cellules du tableau des usables
	CellsFromWhereToCombo = [];
	var AllEnemies = EnemiesLeek+EnemiesBulb;
	
	for(var tool in UsableTab)
	{
		if(isWeapon(tool))	//it s a weapon
			for(var en in AllEnemies)
				for(var cell in WeaponAreaTab[en][tool])
				{	//check every cells where this weapon can be used
					if(ReachableAssociative[Leek][cell] != null && CellsFromWhereToCombo[cell] == null)	//if we havent seen this cell yet and it is reachable, add it to the array
						CellsFromWhereToCombo[cell] = tool;
				}
		else
			for(var en in AllEnemies)
				for(var cell in ChipAreaTab[en][tool])
				{	//check every cells where this chip can be used
					if(ReachableAssociative[Leek][cell] != null && CellsFromWhereToCombo[cell] == null)	//if we havent seen this cell yet and it is reachable, add it to the array
						CellsFromWhereToCombo[cell] = tool;
				}
	}
}


function FillWeaponAreaTab(Leek, DebugWeap, Enem)
{	//give an array with all the cells where you can use any weapon
	var AllWeap = getWeapons(Leek);
	
	for(var weap in AllWeap)
	{
		for(var enn in Enem)
		{
			if(WeaponAreaTab[enn] == null)
				WeaponAreaTab[enn] = [];
			
			WeaponAreaTab[enn][weap] = [];
			//getCellsToUseWeaponOnCell(weap, getCell(enn), [WeaponAreaTab[enn][weap], MyLeek,[]]);
			getCellsToUseWeaponAccount(weap, getCell(enn), [WeaponAreaTab[enn][weap], MyLeek,ReachableAssociative[Leek]]);
		}
	}
	if(DebugWeap)
		for(var weap in AllWeap)
			for(var en in Enem)
				mark(WeaponAreaTab[en][weap], getColor(weap*100, weap*20, 100));
}



function FillChipAreaTab(Leek, DebugChip, Enem)
{	//give an array with all the cells where you can use any weapon
	var Chips = getChips(Leek);
	var ThisCell = getCell(Leek);
	
	for(var chip in Chips)
	{
		var effe = getChipEffects(chip)[0][0];
		if( effe == EFFECT_DAMAGE || effe == EFFECT_POISON)
		{
			for(var enn in Enem){
				if(ChipAreaTab[enn]==null)
					ChipAreaTab[enn]=[];
				
				ChipAreaTab[enn][chip] = [];
				getCellsToUseChipAccount(chip, getCell(enn), [ChipAreaTab[enn][chip], MyLeek, ReachableAssociative[Leek]]);
			}
		}
		else
		{
			ChipAreaTab[Leek][chip] = ThisCell;
		}
	}
	if(DebugChip)
		for(var en in Enem)
			for(var chip in Chips)
				mark(ChipAreaTab[en][chip], getColor(chip*100, chip*20, 100));
}