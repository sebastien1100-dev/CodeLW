// @version:1
include("Main");
include("Common");
include("Fill tabs");

function ExecuteCombo(Combo, ActWeap, nearEn)
{
	var HasMovedThisTurn = false;
	for(var tool in Combo)
	{	
		if(isWeapon(tool))
		{
			if(tool != ActWeap)
			{
				setWeapon(tool);
				ActWeap = tool;
				HasMovedThisTurn = false;
			}
			if(!HasMovedThisTurn && getWeaponEffects(tool)[0][0]==EFFECT_POISON)
			{
				moveTowardCell(FarestCell(getCell(nearEn),AllCellsForCombo[tool]));
				HasMovedThisTurn = true;
			}
			else
				moveTowardCell(NearestCell(getCell(MyLeek),AllCellsForCombo[tool]));
			useWeapon(nearEn);
			if(!isAlive(nearEn))
				nearEn = getNearestEnemy();
		}
		else
		{
			if(getChipEffects(tool)[0][0]==EFFECT_POISON)
				moveTowardCell(FarestCell(getCell(nearEn),AllCellsForCombo[tool]));
			else
				moveTowardCell(NearestCell(getCell(MyLeek),AllCellsForCombo[tool]));
			useChip(tool, nearEn);
			if(!isAlive(nearEn))
				nearEn = getNearestEnemy();
		}
	}
}

function GetBestCombo(AllCombos, ActWeapon, nearEn)
{
	//UsablesOnEn
	var CombToUse = [];
	var ActCost = 2000;
	var Maxdam = 0;
	for(var Comb in AllCombos)
	{
		var dam = 0;
		var cost = 0;
		var tempoWeap = ActWeapon;
		for(var tool in Comb)
		{
			var Damage = GetPotentialDamagesOn(nearEn, EnemiesStats[nearEn]["relaBouc"], EnemiesStats[nearEn]["absoBouc"], tool, MyLeek, MyStats["force"],MyStats["magic"]);
			if(Damage < 10)
			{
				removeElement(Comb, tool);
				continue;
			}
			
			dam += Damage;
			cost += getCost(tool);
			if(isWeapon(tool) && tool != tempoWeap)
			{
				cost++;
				tempoWeap = tool;
			}
		}
		if(Maxdam < dam || (Maxdam == dam && cost < ActCost))
		{
			CombToUse = Comb;
			Maxdam = dam;
			ActCost = cost;
		}
		//debug(Comb + " degats " + dam);
	}
	debug(CombToUse + " degats " + Maxdam + " Cost " + ActCost);

	AllCellsForCombo=[];
	for(var tool in CombToUse)
	{
		var tab = [];
		if(isWeapon(tool))
			tab = WeaponAreaTab[nearEn][tool];
		else
			tab = ChipAreaTab[nearEn][tool];
		
		AllCellsForCombo[tool] = [];
		for(var cell in tab)
			if( CellsFromWhereToCombo[cell] != null && !inArray(AllCellsForCombo[tool], cell))
				push(AllCellsForCombo[tool], cell);
	}
	
	return CombToUse;
}

function tools2Combo(Usables, nbTP, ActWeapon)
{
	if(Usables == [] || nbTP < 2)
		return [];
	
	var AllCombo = [];
	Usables = arraySort(Usables, function(x,y){ return x-y; });
	//debug(Usables);
	
	ComboRec(Usables, nbTP, [] , ActWeapon, AllCombo);
	//ComboRecursifOriginal(AllCombo, Usables, nbTP, [], ActWeapon, false);
	
	var NewTab = [];
	for(var Combo1 in AllCombo)
	{
		if(NewTab == [])
			push(NewTab, Combo1);
		if(!inArray(NewTab, Combo1))
		{
			var Cmpt = 0;
			for(var Combo2 in NewTab)
			{
				if(!IsSameCombo(Combo1, Combo2))
					Cmpt++;
			}
			if(Cmpt == count(NewTab))
				push(NewTab, Combo1);
		}
	}
	//debug(NewTab);
	return NewTab;
}


function ComboRec(Usables, nbTP, Combo, ActWeapon, @AllCombo)
{
	//debug(Combo+" is current combo "+Usables);
	var cmpt = 0;
	for(var tool in Usables)
	{
		var cost = getCost(tool);
		var ChangeWeap;
		
		if(isWeapon(tool) && tool != ActWeapon)
			ChangeWeap = true;
		else
			ChangeWeap = false;
		
		if(cost <= nbTP)
		{
			var NewCombo = Combo;
			var NewUsables = Usables;
			//debug("This tool "+tool);
			if(ChangeWeap && cost+1 <= nbTP)
			{	//is there is a change of weapon
				var NewTps = nbTP-1;
				NewUsables = RemoveFromTab(NewUsables, tool);
				
				for (var i = 1; i <= HowManyAttacks(cost, NewTps); i++)
				{
					push(NewCombo, tool);
					ComboRec(NewUsables, NewTps-(cost*i), NewCombo, tool, AllCombo);
				}
			}
			else if(!ChangeWeap)
			{	//no change of weapon
				NewUsables = RemoveFromTab(NewUsables, tool);
				if(IsCooldown(tool))
				{	//use one time then remove
					push(NewCombo, tool);
					ComboRec(NewUsables, nbTP-cost, NewCombo, ActWeapon, @AllCombo);
				}
				else
				{	//no cooldown
					var nbAttacks = HowManyAttacks(cost, nbTP);
					for (var i = 1; i <= nbAttacks; i++)
					{
						push(NewCombo, tool);
						ComboRec(NewUsables, nbTP-(cost*i), NewCombo, ActWeapon, @AllCombo);
					}
				}
			}
			else
				cmpt++;
		}
		else
		{	//Cet element ne peut pas etre ajouter
			cmpt++;
		}
	}
	
	if(cmpt == count(Usables))	//rien a ajouter, ajouter le combo
	{
		//debug(" " + Combo);
		push(AllCombo, Combo);
	}
}


function IsSameCombo(Combo1, Combo2)
{
	for(var tool in Combo1)
	{
		if(inArray(Combo2, tool))
			removeElement(Combo2, tool);
		else
			return false;
	}
	if( count(Combo2) > 0)
		return false;
	return true;
}

function OrganiseCombo(Combo)
{
	var Trc = [];
	var Test = 0;
	for(var elem in Combo)
	{
		if(elem == Test)
			Trc[elem]++;
		else
		{
			Trc[elem] = 1;
			Test = elem;
		}
	}
	/*if(Test == Combo[0])
		return -1;*/
	return Trc;
}

function isInComboList(Combo, ComboList)
{
	for(var PCombo in ComboList)
		if(SameCombos(Combo, PCombo))
			return true;
	return false;
}

function SameCombos(Combo1, Combo2)
{	//if a Combo == PCombo
	for(var Elem:var I in Combo2)
		if(I != Combo1[Elem])
			return false;
	return true;
}

function RemoveFromTab(Tableau, element)//, @NewTab)
{	//renvoi un nouveau tableau avec l'element element en moins
	var NewTab = [];
	for(var El in Tableau)
		if(El != element)
			push(NewTab, El);
	return NewTab;
}


function HowManyAttacks(cost, PT)
{   //give you the number of attacks in x PT
    var MaxUses = 0;
    for(var i=0; i<PT; i++)
    {
        if(i*cost<PT)
            MaxUses = i;
        else if(i*cost==PT)
            return i;
        else
            return MaxUses;
    }
    return 0;
}


function NearestCell(Mycell, AllCells)
{	//return the nearest cell of an array
	var nearest=-1;
	var distToNear=100;
	for(var C in AllCells)
	{
		var dit = getPathLength(Mycell, C);
		if(dit!=null and dit <= distToNear)
		{
			distToNear = dit;
			nearest = C;
		}
	}
	return nearest;
}

function FarestCell(Cell, AllCells)
{	//return the farest cell of an array
	var farest=-1;
	var distToFar=0;
	for(var C in AllCells)
	{
		var dit = getPathLength(Cell, C);
		if(dit!=null && dit >= distToFar)
		{
			distToFar = dit;
			farest = C;
		}
	}
	return farest;
}