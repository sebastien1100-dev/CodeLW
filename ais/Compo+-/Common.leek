global CanUseInEnemy = [];
global AllCellsForCombo = [];

global FightMyself = false;

function UsableOnCell(FromCell, CellToUse, Usables)
{	//return all the weapon and chip Usable in the cell CellToUse from your FromCell 
	var List = [];
	
	for(var Trc in Usables)
	{
		if(canUseObjectFromCell1OnCell2(Trc, FromCell, CellToUse))
			push(List, Trc);
	}
	return List;
}

function Initiate(DebugMyInfos, DebugEnInfos)
{	//first function to be called, executed once in the program
	MyWeapons = treatWeapons(MyLeek, DebugMyInfos);
	FillSimplifiedWeaponInfos();
	
	MyChips = chipsTab(MyLeek);
	//debug(MyChips);
	
	for(var En in EnemiesLeek)
	{
		EnemiesWeap = treatWeapons(En, DebugEnInfos);
		EnemiesChips = chipsTab(En);
	}
	
	var FightTypeName = FightType();
	setWeapon(MyWeapons["LASER"]);
	if(getWeapon() == null)
		setWeapon(getWeapons(MyLeek)[0]);
}



function canUseObjectFromCell1OnCell2(Object, Cell1, Cell2)
{
	var Area = [];
	if(isWeapon(Object))
		Area = getWeaponEffectiveArea(Object, Cell2, Cell1);
	else
		Area = getChipEffectiveArea(Object, Cell2, Cell1);
	if(Area[0] != null)
		return true;
	return false;
}


function getEntityType(entity)
{
	if(!isSummon(entity)) return ENTITY_LEEK_;
	var chips = getChips(entity);
	if(inArray(chips, CHIP_VACCINE)) return ENTITY_HEALER_BULB;
	if(inArray(chips, CHIP_FORTRESS)) return ENTITY_METALLIC_BULB;
	if(inArray(chips, CHIP_ROCKFALL)) return ENTITY_ROCKY_BULB;
	if(inArray(chips, CHIP_ICEBERG)) return ENTITY_ICED_BULB;
	if(inArray(chips, CHIP_METEORITE)) return ENTITY_FIRE_BULB;
	if(inArray(chips, CHIP_LIGHTNING)) return ENTITY_LIGHTNING_BULB;
	return ENTITY_PUNY_BULB;
}

function LeekEnemies(NameDebug)
{	//get all Enemies leek
    EnemiesLeek=[];
	EnemiesBulb = [];
	var en = getAliveEnemies();
    for(var E in en)
    {
        if(!isSummon(E))
		{
			if(NameDebug)
				debug("enemy leek : "+getName(E));
			push(EnemiesLeek, E);
		}
		else
		{	//ajouter les bulbes qu'on veux traiter
			AllChips[E] = getChips(E);
			push(EnemiesBulb, E);
			push(EnemiesLeek, E);
		}
    }
}


function getPsnDmg(leek)
{	//get the poison dammage on turns
	var dmg = ["turn":0, "all":0];
	for(var effect in getEffects(leek)){
		if(effect[5] == WEAPON_GAZOR
		|| effect[5] == WEAPON_FLAME_THROWER
		|| effect[5] == CHIP_VENOM
		|| effect[5] == CHIP_TOXIN
		|| effect[5] == CHIP_PLAGUE)
		{
			dmg["all"]+= effect[1]*effect[3];
			dmg["turn"]+= effect[1];
		}
	}
	return dmg;
}

function autoLiberateIfNeeded()
{	//Liberate someone if poisonned
	var trc = getAliveAllies();
	push(trc, MyLeek);
	for(var leek in trc){
		if(!isSummon(leek) && (canUseChip(CHIP_ANTIDOTE, leek) || canUseChip(CHIP_LIBERATION, leek))){
			var poison = getPsnDmg(leek);
			if(poison["all"] > getTotalLife(leek)/3)
				useChip(CHIP_ANTIDOTE, leek);
			else if(poison["turn"] > getLife(leek)/4)
				useChip(CHIP_LIBERATION, leek);
		}
	}
}

function getDamagePercentage(cell1, cell2, area)
{
	if (cell1 == cell2) return 1/100;
	var dist = getCellDistance(cell1, cell2);
	var areaDist = 0;
	
	if(AREA_CIRCLE_1 == area)
		areaDist = 1;
	else if(AREA_CIRCLE_2 == area)
		areaDist = 2;
	else if(AREA_CIRCLE_3 == area)
		areaDist = 3;
		
	if(dist > areaDist )
		return 0;
	
	return 1/(100 - ((50 / areaDist) * dist));
}

function chipsTab(Leek)
{   //renvoi un tableau avec les puces triées par types
    var LeekChips = getChips(Leek);
    var Chips = [];

    var Heal  = [];
    var AbsoShield= [];
	var RelaShield= [];
    var Attack= [];
    var Debuff= [];
    var Buff  = [];
    var Poison= [];
    var Bulb  = [];
    var Other = [];
	var Damreturn = [];
	var Libe = [];
	var BoostHeal = [];
	var Regeneration = [];
	
    for(var chip in LeekChips)
    {

        var Eff = getChipEffects(chip);
        for(var effects in Eff)
        {
            if(effects[0] == EFFECT_DAMAGE)
                push(Attack, chip);
			
			else if(effects[0] == EFFECT_ANTIDOTE)
				push(Libe, chip);

            else if(effects[0] == EFFECT_HEAL)
				if(chip == CHIP_REGENERATION)
					push(Regeneration, chip);
				else
					push(Heal, chip);
					
			else if(effects[0] == EFFECT_BOOST_MAX_LIFE)
				push(BoostHeal, chip);
			else if(effects[0] == EFFECT_DAMAGE_RETURN)
				push(Damreturn, chip);
				
            else if(effects[0] == EFFECT_ABSOLUTE_SHIELD)
				push(AbsoShield, chip);
			else if(effects[0] == EFFECT_RELATIVE_SHIELD)
                push(RelaShield, chip);

            else if(effects[0] == EFFECT_DEBUFF)
                push(Debuff, chip);

            else if(effects[0] == EFFECT_POISON)
                push(Poison, chip);

            else if(effects[0] == EFFECT_SUMMON)
                push(Bulb, chip);

            else if(effects[0] == EFFECT_BUFF_AGILITY or effects[0] == EFFECT_BUFF_FORCE or
                    effects[0] == EFFECT_BUFF_MP or effects[0] == EFFECT_BUFF_RESISTANCE or
                    effects[0] == EFFECT_BUFF_STRENGTH or effects[0] == EFFECT_BUFF_TP or
                    effects[0] == EFFECT_BUFF_WISDOM)
                push(Buff, chip);

            else
                push(Other, chip);
        }
    }

    Chips["Heal"]   = Heal;
    Chips["AbsoShield"] = AbsoShield;
	Chips["RelaShield"] = RelaShield;
    Chips["Debuff"] = Debuff;
    Chips["Buff"]   = Buff;
    Chips["Attack"] = Attack;
    Chips["Invoc"]  = Bulb;
	Chips["Libe"]=Libe;
    Chips["Poison"] = Poison;
	Chips["DamageReturn"] = Damreturn;
	Chips["BoostHeal"] = BoostHeal;
    Chips["Other"]  = Other;
	Chips["Regeneration"] = Regeneration;

    return Chips;
}


function GetPotentialDamagesOn(enemy, EnRelaBouc, EnAbsoBouc, tool, Leek, LeekStrth, LeekMagie)
{	//get the potential damage on the leek enemy by the leek Leek with stats LeekStat by the weapon tool or the chip tool
	var DamReturn = 0;
	for(var effe in getEffects(enemy))
	{
		if(effe[0] == EFFECT_DAMAGE_RETURN)
		{
			DamReturn = effe[1]/100;
			break;
		}
	}
	
	if(tool!=null)
	{
		if(isWeapon(tool))
		{
			var wInfos = SimplifiedWeaponInfos[tool];
			var potentialDMG = 0;
			if(wInfos["type"]==EFFECT_DAMAGE)
			{
				potentialDMG = wInfos["min"]*(1+(LeekStrth/100));
				potentialDMG = potentialDMG*(1-EnRelaBouc/100)-EnAbsoBouc;
				
				if(DamReturn > 0)
				{
					var Dam = wInfos["max"]*(1+(LeekStrth/100)) *DamReturn;
					//debugE(Dam+" damage "+getWeaponName(tool)+" "+potentialDMG );
					if((Dam >= potentialDMG/2) || (Dam >= getLife()/4) )
						return 0;
				}
			}
			else if(wInfos["type"]==EFFECT_POISON)
				potentialDMG = wInfos["min"]*(1+(LeekMagie/100)) * wInfos["turn"];
			else
				debugE("getMySimplifiedPotentialDmg:UNKNOWN_WEAPON_TYPE : "+wInfos["type"]);
				
			if(potentialDMG < 0)
				return 0;
				
			return round(potentialDMG);
		}
		else
		{
			var Effects =  getChipEffects(tool)[0];
			if(Effects[0]!=EFFECT_DAMAGE && Effects[0]!=EFFECT_POISON)
				return 0;
			var DamagMoy = Effects[1];//((Effects[1]+Effects[2])/2);
			
			var potentialDMG = 0;
			if(Effects[0]==EFFECT_DAMAGE)
			{
				potentialDMG = DamagMoy*(1+LeekStrth/100);
				potentialDMG = potentialDMG*(1-EnRelaBouc/100)-EnAbsoBouc;
				
				if(DamReturn > 0)
				{
					var Dam = Effects[2]*(1+(LeekStrth/100));
					if((Dam*DamReturn >= potentialDMG/2) || (Dam*DamReturn >= getLife()/4) )
						return 0;
				}
			}
			else
			{
				potentialDMG = DamagMoy*(1+(LeekMagie/100)) * Effects[3];
			}
			if(potentialDMG < 0)
				return 0;
			return round(potentialDMG);
		}
	}
	return 0;
}















