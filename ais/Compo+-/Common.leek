function FightType()
{   //message de debut de combat
    var fight = getFightContext();
    var fightType = getFightType();

    if(fight==FIGHT_CONTEXT_TEST)
	{
        say("Svp laiss moa testé");
	}
    else if(fight==FIGHT_CONTEXT_GARDEN)
    {
        if(fightType == FIGHT_TYPE_TEAM)
            say("Deus Vult ! Mort aux renegas de " + getTeamName(getNearestEnemy()));
		else if(fightType == FIGHT_TYPE_FARMER)
			say("Cette terre m'appartient, " + getFarmerName(getNearestEnemy()) + " !");
        else
			say("Que trepasse si je faiblis !");
    }
    else if(fight==FIGHT_CONTEXT_TOURNAMENT)
	{
        if(fightType == FIGHT_TYPE_TEAM)
            say("Deus Vult mes frères !");
		else if(fightType == FIGHT_TYPE_FARMER)
			say("Attend c'est pas du 1V1 ?..");
        else
		{
			say("Viens faire un bisous a Mémé");
			var nearen = getNearestEnemy();
			if(getFarmerName(getLeek()) == getFarmerName(nearen))
			{
				if(getLevel() >= getLevel(nearen))
				{
					var mess = getMessages();
					if(mess != [])
						FightMyself = true;
					else
						sendTo(nearen, MESSAGE_ATTACK, []);
				}
				else
					FightMyself = true;
				
				debug(FightMyself);
			}
		}
			
	}

    else if(fight==FIGHT_CONTEXT_CHALLENGE)
	{
		var nearen = getNearestEnemy();
		say("Tu veux tater mes biceps " + getName(nearen) + " ?");
		
	}
	
	
	

    if(fightType == FIGHT_TYPE_BATTLE_ROYALE)
        return "Battle royale";
    else if(fightType == FIGHT_TYPE_FARMER)
        return "Farmer";
    else if(fightType == FIGHT_TYPE_SOLO)
        return "Solo";
    else if(fightType == FIGHT_TYPE_TEAM)
        return "Team";
    else
        return "WTF ?";
}

function DispOpsPercent(strg, previous)
{
	var ops = round((getOperations()/OPERATIONS_LIMIT *100 - previous)*1000 )/1000;
	debugW( strg + " " + ops);
	return ops;
}

function treatWeapons(leek, ActDebug)
{	//give an array with all the weapons classified
    var Weapons = getWeapons(leek);
    var WeaponTab = [];

        for(var Actual in Weapons)
        {
			var WeapArea = getWeaponArea(Actual);
            if((Actual == WEAPON_BROADSWORD or Actual == WEAPON_AXE or Actual == WEAPON_KATANA) and WeaponTab["CAC"]==null) //CAC
			{
				WeaponTab["CAC"] = Actual;
				if(ActDebug)
					debug("Cac : " + getWeaponName(Actual));
			}
			
			else if( (Actual==WEAPON_FLAME_THROWER or Actual == WEAPON_GAZOR) and WeaponTab["POISON"]==null )
			{
				WeaponTab["POISON"]=Actual;
				if(ActDebug)
					debug("Poison : " + getWeaponName(Actual));
			}

            else if( WeapArea != AREA_POINT and WeapArea != AREA_LASER_LINE and WeaponTab["ZONE"]==null)    //Arme de zone ou laser
			{
				WeaponTab["ZONE"]= Actual;
				if(ActDebug)
					debug("Zone : " + getWeaponName(Actual));
			}

            else if( WeapArea == AREA_LASER_LINE and WeaponTab["LASER"]==null)    //Arme de zone ou laser
			{
				WeaponTab["LASER"]= Actual;
				if(ActDebug)
					debug("Laser : " + getWeaponName(Actual));
			}
			
            else if( WeapArea == AREA_POINT and WeaponTab["GENERAL"]==null)
			{
				WeaponTab["GENERAL"] = Actual;
				if(ActDebug)
					debug("General : " + getWeaponName(Actual));
			}
                
			else
			{
				if(WeaponTab["BONUS"]==null)
				{
					WeaponTab["BONUS"] = Actual;
					if(ActDebug)
						debug("Bonus : " + getWeaponName(Actual));
				}
				else
				{
					WeaponTab["BONUS2"] = Actual;
					if(ActDebug)
						debug("Bonus 2 : " + getWeaponName(Actual));
				}
				
			}
				
        }
   if(ActDebug)
  	 debug("");
    return WeaponTab;
}

