// =====================================================================
//  Opti - IA générique (LeekScript 4)
//  Principe : à chaque tour on cherche la meilleure (case, cible, combo)
//  parmi les cases accessibles, on se boost si on peut taper, on exécute,
//  puis on dépense les PT restants (boucliers, soins, boosts) et on se cache.
// =====================================================================

global ME = getEntity();
global DBG = false;
global AGGRO_TURN = 20;  // après ce tour on arrête de jouer la prudence
global IDLE = 0;         // tours consécutifs sans attaquer
global USE_IDLE_AGGRO = false;
global USE_DEBUFF = false;
global USE_BULBS = true;
global THREAT_COST = 350;   // (ancien modèle) pénalité par ennemi pouvant me frapper
global DANGER_W = 0.6;      // poids des dégâts encaissables dans le choix de la case d'attaque
global LOS_FACTOR = 0.6;    // dégâts attendus d'un ennemi sans ligne de vue actuelle
global SAFE_RATIO = 0.05;
global CRIT_BONUS = 0.3;    // un coup critique fait x1.3 de dégâts
global USE_AREA = false;    // gestion des zones (bonus multi-cibles, tirs amis) : testée sans gain, désactivée
global FRIENDLY_W = 1.5;    // poids des dégâts infligés à nos alliés/bulbes/nous-même par une arme de zone
global SUPPORT_RANGE = 5;   // portée typique des boosts sur allié
global FOCUS_MULT = 1.4;    // bonus pour la cible commune de l'équipe (combats à plusieurs)   // en dessous de ce % de ma vie, une case est considérée sûre
global BOOTS_MIN_SCORE = 500;  // valeur mini d'une attaque pour justifier les bottes
global POISON_WEIGHT = 0.6;     // un poison vaut moins qu'un dégât direct (peut être soigné / dilué)
global SUMMON_WEIGHT = 0.5;     // priorité plus faible sur les bulbes
global KILL_BONUS = 400;        // bonus pour un kill ce tour

// ---------- classification des outils (une seule fois) ----------
global DMG_TOOLS;     // armes + puces qui font des dégâts / poison
global HEAL_CHIPS;
global SHIELD_CHIPS;
global TP_BUFF_CHIPS;
global STR_BUFF_CHIPS;
global MP_BUFF_CHIPS;
global RETURN_CHIPS;
global CLEANSE_CHIPS;  // antidote / libération
global SUMMON_CHIPS;
global OTHER_BUFF_CHIPS;  // sagesse, résistance, agilité, vitalité (utile au soutien)
global TOOL_INFO;      // map tool -> [cost, dmgMin, dmgMax, poisonMin, poisonMax, poisonTurns, isWeapon, maxUses]

function effectsOf(tool, isW) {
	return isW ? getWeaponEffects(tool) : getChipEffects(tool);
}

function classify() {
	DMG_TOOLS = []; HEAL_CHIPS = []; SHIELD_CHIPS = []; TP_BUFF_CHIPS = [];
	STR_BUFF_CHIPS = []; MP_BUFF_CHIPS = []; RETURN_CHIPS = []; CLEANSE_CHIPS = []; SUMMON_CHIPS = []; OTHER_BUFF_CHIPS = [];
	TOOL_INFO = [:];
	for (var w in getWeapons()) {
		register(w, true);
	}
	for (var c in getChips()) {
		register(c, false);
	}
}

function register(tool, isW) {
	var dMin = 0, dMax = 0, pMin = 0, pMax = 0, pTurns = 0;
	var otherb = false, summ = false, after = false, heal = false, shield = false, tpb = false, strb = false, mpb = false, ret = false, clean = false;
	for (var e in effectsOf(tool, isW)) {
		var t = e[0];
		if (t == EFFECT_DAMAGE) { dMin += e[1]; dMax += e[2]; }
		else if (t == EFFECT_POISON) { pMin += e[1]; pMax += e[2]; pTurns = max(pTurns, e[3]); }
		else if (t == EFFECT_HEAL) heal = true;
		else if (t == EFFECT_RELATIVE_SHIELD || t == EFFECT_ABSOLUTE_SHIELD || t == EFFECT_RAW_ABSOLUTE_SHIELD) shield = true;
		else if (t == EFFECT_RAW_BUFF_TP || t == EFFECT_BUFF_TP) tpb = true;
		else if (t == EFFECT_RAW_BUFF_STRENGTH || t == EFFECT_BUFF_STRENGTH) strb = true;
		else if (t == EFFECT_RAW_BUFF_MP || t == EFFECT_BUFF_MP) mpb = true;
		else if (t == EFFECT_DAMAGE_RETURN) ret = true;
		else if (t == EFFECT_ANTIDOTE || t == EFFECT_DEBUFF) clean = true;
		else if (t == EFFECT_AFTEREFFECT) after = true;
		else if (t == EFFECT_SUMMON) summ = true;
		else if (t == EFFECT_RAW_BUFF_WISDOM || t == EFFECT_BUFF_WISDOM || t == EFFECT_RAW_BUFF_RESISTANCE || t == EFFECT_BUFF_RESISTANCE
			|| t == EFFECT_RAW_BUFF_AGILITY || t == EFFECT_BUFF_AGILITY || t == EFFECT_BOOST_MAX_LIFE) otherb = true;
	}
	var cost = isW ? getWeaponCost(tool) : getChipCost(tool);
	var uses = isW ? getWeaponMaxUses(tool) : getChipMaxUses(tool);
	if (uses <= 0) uses = 10;
	TOOL_INFO[tool] = [cost, dMin, dMax, pMin, pMax, pTurns, isW, uses];
	if (dMax > 0 || pMax > 0) push(DMG_TOOLS, tool);
	else if (isW) return;
	else if (summ) push(SUMMON_CHIPS, tool);
	else if (heal) push(HEAL_CHIPS, tool);
	else if (shield) push(SHIELD_CHIPS, tool);
	else if (tpb) push(TP_BUFF_CHIPS, tool);
	else if (strb && !after) push(STR_BUFF_CHIPS, tool);
	else if (mpb) push(MP_BUFF_CHIPS, tool);
	else if (ret) push(RETURN_CHIPS, tool);
	else if (clean) push(CLEANSE_CHIPS, tool);
	else if (otherb) push(OTHER_BUFF_CHIPS, tool);
}

if (getTurn() == 1) classify();

// ---------- utilitaires ----------
// ennemis qui combattent : on ignore les entités statiques (coffres...) sauf s'il ne reste qu'elles
function isStatic(e) {
	return getTotalMP(e) == 0 && count(getWeapons(e)) == 0 && count(getChips(e)) == 0;
}
function foes() {
	var res = [];
	for (var e in getAliveEnemies()) if (!isStatic(e)) push(res, e);
	return count(res) > 0 ? res : getAliveEnemies();
}
function nearestFoe() {
	var best = null, bd = 100000;
	for (var e in foes()) {
		var d = getCellDistance(getCell(), getCell(e));
		if (d < bd) { bd = d; best = e; }
	}
	return best;
}
// on passe à l'offensive : fin de partie, ou on attend depuis 2 tours sans être en retard de vie
function isAggressive() {
	if (getTurn() > AGGRO_TURN) return true;
	if (!USE_IDLE_AGGRO || IDLE < 2) return false;
	var n = nearestFoe();
	if (n == null) return false;
	return getLife() / getTotalLife() >= getLife(n) / getTotalLife(n) - 0.1;
}


function toolCost(tool) { return TOOL_INFO[tool][0]; }
function isW(tool) { return TOOL_INFO[tool][6]; }

function chipReady(chip) {
	return getCooldown(chip) == 0 && getChipCost(chip) <= getTP();
}

function damageReturnOf(e) {
	var r = 0;
	for (var ef in getEffects(e)) if (ef[0] == EFFECT_DAMAGE_RETURN) r += ef[1];
	return r / 100;
}

// dégât espéré d'une utilisation de tool sur e
// dégâts moyens avec les coups critiques : x1.3, probabilité ~ agilité / 1000
function critFactor(ent) { return 1 + CRIT_BONUS * min(1, max(0, getAgility(ent)) / 1000); }

function hitValue(tool, e) {
	var i = TOOL_INFO[tool];
	var v = 0;
	if (i[2] > 0) {
		var d = (i[1] + i[2]) / 2 * (1 + getStrength() / 100) * critFactor(ME);
		d = d * (1 - getRelativeShield(e) / 100) - getAbsoluteShield(e);
		if (d > 0) v += d;
	}
	if (i[4] > 0) {
		var p = (i[3] + i[4]) / 2 * (1 + getMagic() / 100);
		p = p * (1 - getRelativeShield(e) / 100) - getAbsoluteShield(e);
		if (p > 0) v += p * i[5] * POISON_WEIGHT;
	}
	return v;
}


// ---------- armes et puces de zone ----------
function toolArea(tool) { return isW(tool) ? getWeaponArea(tool) : getChipArea(tool); }
function isAreaTool(tool) { return toolArea(tool) != AREA_POINT; }

// cibles possibles des dégâts d'un outil (bits du jeu : 2 = alliés, 4 = lanceur)
function damageTargets(tool) {
	for (var ef in effectsOf(tool, isW(tool))) if (ef[0] == EFFECT_DAMAGE || ef[0] == EFFECT_POISON) return ef[4];
	return 31;
}

// bilan d'un tir de zone sur `target` depuis `from` : [dégâts ennemis, dégâts amis] (amis = alliés, bulbes, moi)
function areaOutcome(tool, target, from) {
	var cells = isW(tool) ? getWeaponEffectiveArea(tool, target, from) : getChipEffectiveArea(tool, target, from);
	if (cells == null) return [0, 0];
	var line = toolArea(tool) == AREA_LASER_LINE;
	var radius = 1;
	if (!line) for (var c in cells) radius = max(radius, getCellDistance(c, target));
	var tg = damageTargets(tool);
	var foe = 0, friend = 0;
	for (var c in cells) {
		var ent = getEntityOnCell(c);
		if (ent == null || ent < 0 || !isAlive(ent)) continue;
		var f = line ? 1 : 1 - 0.5 * getCellDistance(c, target) / radius;
		var v = hitValue(tool, ent) * f;
		if (ent == ME) { if (tg & 4) friend += v; }
		else if (isAlly(ent)) { if (tg & 2) friend += v * (isSummon(ent) ? 0.5 : 1); }
		else foe += v * (isSummon(ent) ? SUMMON_WEIGHT : 1);
	}
	return [foe, friend];
}

// bonus/malus de zone pour la planification (zones circulaires : ne dépend pas de la case de tir)
global SPLASH = [:];
global SPLASH_TURN = -1;
function splash(tool, e) {
	if (!USE_AREA) return 0;
	if (!isAreaTool(tool) || toolArea(tool) == AREA_LASER_LINE) return 0;
	if (SPLASH_TURN != getTurn()) { SPLASH = [:]; SPLASH_TURN = getTurn(); }
	var key = tool + "_" + e;
	var v = SPLASH[key];
	if (v != null) return v;
	var o = areaOutcome(tool, getCell(e), getCell());
	v = (o[0] - hitValue(tool, e) * (isSummon(e) ? SUMMON_WEIGHT : 1)) - o[1] * FRIENDLY_W;
	SPLASH[key] = v;
	return v;
}

// cases accessibles : map cell -> distance
function reachable(mp) {
	var res = [:];
	var from = getCell();
	res[from] = 0;
	var x0 = getCellX(from), y0 = getCellY(from);
	for (var dx = -mp; dx <= mp; dx++) {
		var r = mp - abs(dx);
		for (var dy = -r; dy <= r; dy++) {
			if (dx == 0 && dy == 0) continue;
			var c = getCellFromXY(x0 + dx, y0 + dy);
			if (c == null) continue;
			var l = getPathLength(from, c);
			if (l != null && l <= mp) res[c] = l;
		}
	}
	return res;
}

// cases depuis lesquelles tool touche e (en ignorant ma propre case)
function cellsFor(tool, e) {
	var cells = isW(tool) ? getCellsToUseWeapon(tool, e, [getCell()]) : getCellsToUseChip(tool, e, [getCell()]);
	if (cells == null || count(cells) == 0) return null;
	var s = [:];
	for (var c in cells) s[c] = true;
	return s;
}

// sac à dos par groupe : meilleur combo de tools sur e avec tp PT
// renvoie [valeur, [[tool, nb], ...]]
function bestCombo(tools, e, tp) {
	var cur = getWeapon();
	var best = [];
	var pick = [];
	for (var t = 0; t <= tp; t++) { push(best, 0); }
	var choice = [];  // choice[k][t] = nb d'utilisations de tools[k] avec t PT
	var k = 0;
	for (var tool in tools) {
		var cost = toolCost(tool);
		var extra = (isW(tool) && tool != cur) ? 1 : 0;
		var maxUses = TOOL_INFO[tool][7];
		if (!isW(tool)) {
			if (getCooldown(tool) > 0) maxUses = 0;
			else if (getChipCooldown(tool) > 0) maxUses = 1;
		}
		var hv = hitValue(tool, e) + splash(tool, e);
		var nb = [];
		var nbest = [];
		for (var t = 0; t <= tp; t++) {
			var bv = best[t];
			var bn = 0;
			for (var n = 1; n <= maxUses; n++) {
				var c = n * cost + extra;
				if (c > t) break;
				var v = best[t - c] + n * hv;
				if (v > bv) { bv = v; bn = n; }
			}
			push(nbest, bv);
			push(nb, bn);
		}
		best = nbest;
		push(choice, nb);
		k++;
	}
	// reconstruction
	var plan = [];
	var t = tp;
	for (var j = count(tools) - 1; j >= 0; j--) {
		var n = choice[j][t];
		if (n > 0) {
			var tool = tools[j];
			push(plan, [tool, n]);
			t -= n * toolCost(tool) + ((isW(tool) && tool != cur) ? 1 : 0);
		}
	}
	return [best[tp], plan];
}

// cible commune de l'équipe : tous nos poireaux font le même calcul, donc convergent sur le même ennemi
// (le poireau ennemi le plus facile à abattre : vie effective = vie protégée par ses boucliers)
global FOCUS = null;
global FOCUS_TURN = -1;
function focusTarget() {
	if (FOCUS_TURN == getTurn() && FOCUS != null && isAlive(FOCUS)) return FOCUS;
	FOCUS = null;
	var best = 1000000000;
	for (var e in foes()) {
		if (isSummon(e) || isStatic(e)) continue;
		var eff = getLife(e) / max(0.1, 1 - getRelativeShield(e) / 100) + getAbsoluteShield(e) * 3;
		if (eff < best) { best = eff; FOCUS = e; }
	}
	FOCUS_TURN = getTurn();
	return FOCUS;
}

function targetScore(e, dmg) {
	var life = getLife(e);
	var ret = damageReturnOf(e) * min(dmg, life);
	var s = min(dmg, life);
	if (dmg >= life) s += KILL_BONUS + life * 0.5;
	if (isSummon(e)) s *= SUMMON_WEIGHT;
	if (count(getAliveAllies()) > 1 && e == focusTarget()) s *= FOCUS_MULT;
	return s - ret * 1.5;
}

// meilleur plan : [score, cell, enemy, combo]
function planAttack(tp) {
	var aggressive = isAggressive();
	var reach = reachable(getMP());
	var best = null;
	for (var e in foes()) {
		var usable = [];
		var sets = [];
		for (var tool in DMG_TOOLS) {
			if (!isW(tool) && getCooldown(tool) > 0) continue;
			if (toolCost(tool) > tp) continue;
			if (hitValue(tool, e) + splash(tool, e) <= 0) continue;
			var s = cellsFor(tool, e);
			if (DBG) debug('  tool ' + (isW(tool) ? getWeaponName(tool) : getChipName(tool)) + ' cells=' + (s == null ? 0 : mapSize(s)) + ' hv=' + hitValue(tool, e));
			if (s == null) continue;
			push(usable, tool);
			push(sets, s);
		}
		if (count(usable) == 0) continue;
		var memo = [:];
		for (var cell : var dist in reach) {
			var mask = "";
			var tools = [];
			for (var i = 0; i < count(usable); i++) {
				if (sets[i][cell] != null) { push(tools, usable[i]); mask += "1"; }
				else mask += "0";
			}
			if (count(tools) == 0) continue;
			var r = memo[mask];
			if (r == null) { r = bestCombo(tools, e, tp); memo[mask] = r; }
			if (r[0] <= 0) continue;
			var sc = targetScore(e, r[0]) - dist * 15;
			if (!aggressive) {
				// attaquer depuis une case menacée coûte cher, surtout sans PM pour repartir
				var dg = danger(cell);
				if (dg > 0) sc -= dg * DANGER_W * (getMP() - dist <= 1 ? 1 : 0.5);
			}
			if (best == null || sc > best[0]) best = [sc, cell, e, r[1]];
		}
	}
	if (best != null && best[0] <= 0) return null;
	return best;
}

// tir de zone acceptable depuis ma case actuelle : les dégâts amis ne dépassent pas la moitié des dégâts ennemis
function areaIsSafe(tool, e) {
	if (!USE_AREA) return true;
	if (!isAreaTool(tool)) return true;
	var o = areaOutcome(tool, getCell(e), getCell());
	return o[1] * FRIENDLY_W <= o[0] * 0.5;
}

function execute(plan) {
	debug('exec ' + [plan[1], getCell(), plan[3]]);
	var cell = plan[1];
	var e = plan[2];
	if (cell != getCell()) moveTowardCell(cell);
	// arme actuelle d'abord, puis le reste
	var combo = plan[3];
	var cur = getWeapon();
	var ordered = [];
	for (var p in combo) if (p[0] == cur) push(ordered, p);
	for (var p in combo) if (p[0] != cur) push(ordered, p);
	for (var p in ordered) {
		var tool = p[0];
		for (var n = 0; n < p[1]; n++) {
			if (!isAlive(e)) return;
			if (isW(tool)) {
				// changer d'arme coûte 1 PT : ne le faire que si on pourra tirer ensuite
				if (getWeapon() != tool) {
					if (getTP() < getWeaponCost(tool) + 1) break;
					setWeapon(tool);
				}
				// la case visée a pu ne pas être atteinte (chemin bloqué) : vérifier portée et ligne de vue
				if (getWeapon() != tool || !canUseWeapon(tool, e)) break;
				if (!areaIsSafe(tool, e)) break;
				if (useWeapon(e) < 0) break;
			} else {
				if (!canUseChip(tool, e)) break;
				if (!areaIsSafe(tool, e)) break;
				if (useChip(tool, e) < 0) break;
			}
		}
	}
}

// ---------- phases ----------
function lifeRatio(e) { return getLife(e) / getTotalLife(e); }

// soin attendu d'une puce (la sagesse du lanceur multiplie les soins)
function healAmount(c) {
	var h = 0;
	for (var ef in getChipEffects(c)) if (ef[0] == EFFECT_HEAL) h += (ef[1] + ef[2]) / 2 * max(1, ef[3]);
	return h * (1 + getWisdom() / 100);
}

function healSelf(threshold) {
	if (lifeRatio(ME) >= threshold) return;
	// la plus grosse heal d'abord (regeneration etc.)
	var sorted = arraySort(HEAL_CHIPS, function(a, b) { return toolCost(b) - toolCost(a); });
	for (var c in sorted) {
		if (lifeRatio(ME) >= threshold) break;
		if (chipReady(c)) useChip(c, ME);
	}
}

function healAllies() {
	for (var a in getAliveAllies()) {
		if (a == ME || isSummon(a) || lifeRatio(a) > 0.6) continue;
		for (var c in HEAL_CHIPS) if (chipReady(c) && canUseChip(c, a)) useChip(c, a);
	}
}

function cleanseIfPoisoned() {
	var poison = 0;
	for (var ef in getEffects(ME)) if (ef[0] == EFFECT_POISON) poison += ef[1] * ef[3];
	if (poison < getLife() * 0.25) return;
	for (var c in CLEANSE_CHIPS) if (chipReady(c)) { useChip(c, ME); return; }
}

function enemyThreatens() {
	// un ennemi peut-il me toucher au prochain tour ? (approximation)
	for (var e in foes()) {
		if (getCellDistance(getCell(), getCell(e)) <= getMP(e) + 10) return true;
	}
	return false;
}

function useBuffs(list) {
	for (var c in list) if (chipReady(c)) useChip(c, ME);
}

// portée max des outils offensifs d'un ennemi
global ENEMY_RANGE = [:];
function enemyRange(e) {
	var r = ENEMY_RANGE[e];
	if (r != null) return r;
	r = 1;
	for (var w in getWeapons(e)) r = max(r, getWeaponMaxRange(w));
	for (var c in getChips(e)) {
		for (var ef in getChipEffects(c)) {
			if (ef[0] == EFFECT_DAMAGE || ef[0] == EFFECT_POISON) { r = max(r, getChipMaxRange(c)); break; }
		}
	}
	ENEMY_RANGE[e] = r;
	return r;
}


// ---------- menace en dégâts ----------
// profil offensif d'un ennemi pour son prochain tour : [[coût, dégât moyen, portée min, portée max, utilisations], ...]
global PROFILE = [:];
global PROFILE_TURN = -1;
function enemyProfile(e) {
	if (PROFILE_TURN != getTurn()) { PROFILE = [:]; PROFILE_TURN = getTurn(); }
	var p = PROFILE[e];
	if (p != null) return p;
	p = [];
	var str = (1 + max(0, getStrength(e)) / 100) * critFactor(e);
	var mag = 1 + max(0, getMagic(e)) / 100;
	for (var w in getWeapons(e)) {
		var d = 0;
		for (var ef in getWeaponEffects(w)) {
			if (ef[0] == EFFECT_DAMAGE) d += (ef[1] + ef[2]) / 2 * str;
			else if (ef[0] == EFFECT_POISON) d += (ef[1] + ef[2]) / 2 * mag * ef[3] * POISON_WEIGHT;
		}
		var u = getWeaponMaxUses(w);
		if (d > 0) push(p, [getWeaponCost(w) + 0.0, d, getWeaponMinRange(w), getWeaponMaxRange(w), u <= 0 ? 10 : u]);
	}
	for (var c in getChips(e)) {
		if (getCooldown(c, e) > 1) continue;  // pas dispo à son prochain tour
		var d = 0;
		for (var ef in getChipEffects(c)) {
			if (ef[0] == EFFECT_DAMAGE) d += (ef[1] + ef[2]) / 2 * str;
			else if (ef[0] == EFFECT_POISON) d += (ef[1] + ef[2]) / 2 * mag * ef[3] * POISON_WEIGHT;
		}
		var u = getChipCooldown(c) > 0 ? 1 : getChipMaxUses(c);
		if (d > 0) push(p, [getChipCost(c) + 0.0, d, getChipMinRange(c), getChipMaxRange(c), u <= 0 ? 10 : u]);
	}
	// meilleur rendement d'abord
	p = arraySort(p, function(a, b) { return b[1] / b[0] - a[1] / a[0]; });
	PROFILE[e] = p;
	return p;
}

// dégâts que les ennemis peuvent m'infliger sur `cell` à leur prochain tour (estimation prudente)
function danger(cell) {
	var total = 0;
	var shield = 1 - getRelativeShield() / 100;
	for (var e in foes()) {
		if (isStatic(e)) continue;
		var mp = getTotalMP(e);
		var dist = getCellDistance(cell, getCell(e));
		var tp = getTotalTP(e);
		var dmg = 0;
		for (var t in enemyProfile(e)) {
			if (dist > mp + t[3]) continue;          // hors d'atteinte même en avançant
			var n = min(t[4], floor(tp / t[0]));
			if (n <= 0) continue;
			dmg += n * t[1];
			tp -= n * t[0];
			if (tp <= 0) break;
		}
		if (dmg <= 0) continue;
		// sans ligne de vue depuis sa position actuelle, il doit encore se déplacer pour tirer
		if (!lineOfSight(getCell(e), cell, [getCell(e), getCell()])) dmg *= LOS_FACTOR;
		total += dmg;
	}
	return max(0, total * shield - getAbsoluteShield());
}

// nombre d'ennemis (non bulbes) qui pourront me frapper sur cette case au prochain tour (approx.)
function threatCount(cell) {
	var n = 0;
	for (var e in foes()) {
		if (isSummon(e)) continue;
		if (getCellDistance(cell, getCell(e)) <= getTotalMP(e) + enemyRange(e)) n++;
	}
	return n;
}

// se placer : hors menace si possible (au plus près), sinon caché, sinon loin
function position() {
	if (getMP() <= 0) return;
	var aggressive = isAggressive();
	var reach = reachable(getMP());
	var bestCell = getCell();
	var bestScore = -1000000;
	for (var cell : var dist in reach) {
		var seen = 0;
		var minD = 1000;
		for (var e in foes()) {
			if (isSummon(e)) continue;
			if (lineOfSight(getCell(e), cell, [getCell(e), getCell()])) seen++;
			minD = min(minD, getCellDistance(cell, getCell(e)));
		}
		var dg = aggressive ? 0 : danger(cell);
		var sc;
		if (dg <= getLife() * SAFE_RATIO) sc = 100000 - seen * 30 - minD;  // sûr : on reste au contact
		else sc = -dg - seen * 50 + minD * 3;                               // exposé : le moins de dégâts possible
		if (sc > bestScore) { bestScore = sc; bestCell = cell; }
	}
	if (bestCell != getCell()) moveTowardCell(bestCell);
}

function hasEffect(e, types) {
	for (var ef in getEffects(e)) if (inArray(types, ef[0])) return true;
	return false;
}

function resurrectAlly() {
	if (!inArray(getChips(), CHIP_RESURRECTION) || getCooldown(CHIP_RESURRECTION) > 0) return;
	var best = null;
	for (var a in getDeadAllies()) {
		if (!isSummon(a) && (best == null || getLevel(a) > getLevel(best))) best = a;
	}
	if (best == null) return;
	for (var c in getCellsToUseChipOnCell(CHIP_RESURRECTION, getCell())) {
		if (resurrect(best, c) > 0) return;
	}
}


// =====================================================================
//  Bulbes
// =====================================================================

// IA générique des bulbes : soigne, protège / booste les alliés, attaque, puis se met à l'abri
// case pour un bulbe de soutien : à portée et en vue de `target`, en limitant les dégâts encaissables
function bulbCell(target) {
	var reach = reachable(getMP());
	var tc = getCell(target);
	var best = getCell(), bestSc = -1000000;
	for (var cell : var dist in reach) {
		var d = getCellDistance(cell, tc);
		var sc = -danger(cell) - dist * 2 - d * 5;
		if (d <= SUPPORT_RANGE && lineOfSight(cell, tc, [tc, getCell()])) sc += 200;
		if (sc > bestSc) { bestSc = sc; best = cell; }
	}
	return best;
}

// IA générique des bulbes : soigner les poireaux blessés, protéger le plus menacé, attaquer la cible commune
function bulbAI() {
	var me = getEntity();
	var heals = [], supports = [], attacks = [];
	for (var c in getChips(me)) {
		var t = getChipEffects(c)[0][0];
		if (t == EFFECT_HEAL) push(heals, c);
		else if (t == EFFECT_DAMAGE || t == EFFECT_POISON) push(attacks, c);
		else push(supports, c);
	}
	// nos poireaux (pas les bulbes), le plus menacé d'abord
	var leeks = [];
	for (var a in getAliveAllies()) if (!isSummon(a)) push(leeks, a);
	leeks = arraySort(leeks, function(a, b) { return danger(getCell(b)) - danger(getCell(a)); });
	var protege = count(leeks) > 0 ? leeks[0] : null;
	var supportive = count(heals) + count(supports) > 0;

	// 1. bulbe de soutien : se placer à portée du protégé
	if (supportive && protege != null) {
		var cell = bulbCell(protege);
		if (cell != getCell()) moveTowardCell(cell);
	}
	// 2. soins : le poireau le plus blessé (puis un bulbe), sans gaspiller
	if (count(heals) > 0) {
		var hurt = null, worst = 0.85;
		for (var a in leeks) if (lifeRatio(a) < worst) { worst = lifeRatio(a); hurt = a; }
		if (hurt == null) for (var a in getAliveAllies()) if (lifeRatio(a) < 0.6) { hurt = a; break; }
		if (hurt != null) {
			for (var c in heals) {
				while (getCooldown(c) == 0 && getTotalLife(hurt) - getLife(hurt) >= healAmount(c) * 0.5
					&& canUseChip(c, hurt) && useChip(c, hurt) > 0) {}
			}
		}
	}
	// 3. boucliers / boosts : le protégé d'abord, puis les autres poireaux
	for (var c in supports) {
		if (getCooldown(c) > 0) continue;
		for (var a in leeks) if (canUseChip(c, a) && useChip(c, a) > 0) break;
	}
	// 4. attaque : la cible commune si on peut l'atteindre, sinon l'ennemi le plus proche
	var targets = [];
	var f = focusTarget();
	if (f != null) push(targets, f);
	var n = nearestFoe();
	if (n != null && n != f) push(targets, n);
	for (var c in attacks) {
		if (getCooldown(c) > 0 || getChipCost(c) > getTP()) continue;
		for (var e in targets) {
			if (!canUseChip(c, e) && getMP() > 0) {
				var best = null, bd = 1000;
				for (var cell in getCellsToUseChip(c, e)) {
					var l = getPathLength(getCell(), cell);
					if (l != null && l <= getMP() && l < bd) { bd = l; best = cell; }
				}
				if (best != null) moveTowardCell(best);
			}
			if (canUseChip(c, e)) {
				while (getCooldown(c) == 0 && getChipCost(c) <= getTP() && useChip(c, e) > 0) {}
				break;
			}
		}
	}
	// 5. fin de tour : le soutien reste près du protégé, l'attaquant se met à l'abri
	if (supportive && protege != null) {
		var cell = bulbCell(protege);
		if (cell != getCell()) moveTowardCell(cell);
	} else position();
}

// invoque les bulbes prêts (les plus chers d'abord), sur une case libre loin des ennemis
function summonBulbs() {
	if (!USE_BULBS) return;
	var chips = arraySort(SUMMON_CHIPS, function(a, b) { return getChipCost(b) - getChipCost(a); });
	for (var chip in chips) {
		if (!chipReady(chip)) continue;
		var from = getCell();
		var x0 = getCellX(from), y0 = getCellY(from);
		var rMax = getChipMaxRange(chip), rMin = getChipMinRange(chip);
		var bestCell = null, bestD = -1;
		for (var dx = -rMax; dx <= rMax; dx++) {
			for (var dy = -rMax; dy <= rMax; dy++) {
				var d = abs(dx) + abs(dy);
				if (d < rMin || d > rMax) continue;
				var c = getCellFromXY(x0 + dx, y0 + dy);
				if (c == null || !isEmptyCell(c) || !lineOfSight(from, c)) continue;
				var minD = 1000;
				for (var e in foes()) minD = min(minD, getCellDistance(c, getCell(e)));
				if (minD > bestD) { bestD = minD; bestCell = c; }
			}
		}
		if (bestCell != null) summon(chip, bestCell, bulbAI);
	}
}


// retire boucliers / boosts de la cible si ça vaut le coup
function debuffTarget(t) {
	if (!USE_DEBUFF) return false;
	var buffed = getAbsoluteShield(t) >= 80 || getRelativeShield(t) >= 15
		|| hasEffect(t, [EFFECT_RAW_BUFF_STRENGTH, EFFECT_BUFF_STRENGTH, EFFECT_DAMAGE_RETURN]);
	if (!buffed) return false;
	for (var c in CLEANSE_CHIPS) {
		var isDebuff = false;
		for (var ef in getChipEffects(c)) if (ef[0] == EFFECT_DEBUFF) isDebuff = true;
		if (isDebuff && chipReady(c) && canUseChip(c, t)) { useChip(c, t); return true; }
	}
	return false;
}


// =====================================================================
//  Rôle soutien (poireau "science") : booste, protège et soigne les alliés
// =====================================================================
global SUPPORT_MIN_SCIENCE = 200;
global DBG_SUPPORT = false;
function isSupport() { return getScience() >= SUPPORT_MIN_SCIENCE; }

// alliés combattants (poireaux, pas les bulbes), le plus proche de l'ennemi d'abord
function fighters() {
	var res = [];
	for (var a in getAliveAllies()) if (a != ME && !isSummon(a)) push(res, a);
	var n = nearestFoe();
	if (n == null) return res;
	return arraySort(res, function(a, b) { return getCellDistance(getCell(a), getCell(n)) - getCellDistance(getCell(b), getCell(n)); });
}

// l'allié porte-t-il déjà l'effet de cette puce ?
function hasChipEffect(a, chip) {
	for (var ef in getEffects(a)) if (ef[5] == chip) return true;
	return false;
}

// valeur d'un boost : les effets "bruts" ne dépendent pas de la science, les autres sont multipliés par (1 + science/100)
function buffValue(chip) {
	var v = 0;
	var sci = 1 + getScience() / 100;
	for (var ef in getChipEffects(chip)) {
		var t = ef[0], avg = (ef[1] + ef[2]) / 2, turns = max(1, ef[3]);
		if (t == EFFECT_BUFF_STRENGTH) v += avg * sci * turns;
		else if (t == EFFECT_RAW_BUFF_STRENGTH) v += avg * turns;
		else if (t == EFFECT_BUFF_TP) v += avg * sci * turns * 120;     // 1 PT ~ 120 de force
		else if (t == EFFECT_RAW_BUFF_TP) v += avg * turns * 120;
		else if (t == EFFECT_BUFF_MP) v += avg * sci * turns * 40;
		else if (t == EFFECT_RAW_BUFF_MP) v += avg * turns * 40;
		else if (t == EFFECT_BUFF_WISDOM || t == EFFECT_BUFF_RESISTANCE || t == EFFECT_BUFF_AGILITY) v += avg * sci * turns * 0.4;
		else if (t == EFFECT_RAW_BUFF_WISDOM || t == EFFECT_RAW_BUFF_RESISTANCE || t == EFFECT_RAW_BUFF_AGILITY) v += avg * turns * 0.4;
	}
	return v / getChipCost(chip);
}

// lance `chip` sur le premier allié de la liste qui est à portée et pas encore boosté
function buffAllies(chip, allies) {
	if (!chipReady(chip)) return false;
	for (var a in allies) {
		if (hasChipEffect(a, chip)) continue;
		if (canUseChip(chip, a)) {
			var r = useChip(chip, a);
			if (DBG_SUPPORT) debug('use ' + getChipName(chip) + ' -> ' + getName(a) + ' = ' + r + ' tp=' + getTP());
			if (r > 0) return true;
		}
	}
	return false;
}

// case où se placer : d'où l'on peut booster le plus d'alliés (portée + ligne de vue), l'allié de tête compte double,
// en limitant les dégâts encaissables ; si personne n'est boostable, on se rapproche de l'allié de tête
function supportCell(allies, dangerWeight) {
	var reach = reachable(getMP());
	if (count(allies) == 0) return getCell();
	var front = allies[0];
	var best = getCell(), bestSc = -1000000;
	for (var cell : var dist in reach) {
		var near = 0;
		for (var a in allies) {
			var ac = getCell(a);
			if (getCellDistance(cell, ac) <= SUPPORT_RANGE && lineOfSight(cell, ac, [ac, getCell()])) near += (a == front ? 2 : 1);
		}
		var sc = near * 150 - danger(cell) * dangerWeight - dist * 2;
		if (near == 0) sc -= getCellDistance(cell, getCell(front)) * 20;
		if (sc > bestSc) { bestSc = sc; best = cell; }
	}
	return best;
}

function supportTurn() {
	cleanseIfPoisoned();
	resurrectAlly();
	var allies = fighters();
	// 1. se rapprocher du groupe pour être à portée
	var cell = supportCell(allies, 0.3);
	if (cell != getCell()) moveTowardCell(cell);
	// 2. soins : l'allié le plus blessé (moi compris)
	var hurt = ME;
	for (var a in allies) if (lifeRatio(a) < lifeRatio(hurt)) hurt = a;
	if (lifeRatio(hurt) < 0.7) {
		var heals = arraySort(HEAL_CHIPS, function(a, b) { return healAmount(b) - healAmount(a); });
		for (var c in heals) if (chipReady(c) && canUseChip(c, hurt)) useChip(c, hurt);
	}
	// 3. boosts : PT d'abord, puis force, puis le reste, sur les alliés les plus avancés
	if (DBG_SUPPORT) {
		for (var a in allies) debug('ally ' + getName(a) + ' dist=' + getCellDistance(getCell(), getCell(a)));
		debug('TP=' + TP_BUFF_CHIPS + ' STR=' + STR_BUFF_CHIPS + ' OTHER=' + OTHER_BUFF_CHIPS + ' SH=' + SHIELD_CHIPS + ' tp=' + getTP());
		for (var c in STR_BUFF_CHIPS) for (var a in allies) if (getCellDistance(getCell(), getCell(a)) <= 6) debug('  ' + getChipName(c) + ' -> ' + getName(a) + ' d=' + getCellDistance(getCell(), getCell(a)) + ' r=' + getChipMinRange(c) + '-' + getChipMaxRange(c) + ' los=' + lineOfSight(getCell(), getCell(a)) + ' can=' + canUseChip(c, a) + ' onCell=' + canUseChipOnCell(c, getCell(a)) + ' isAlly=' + isAlly(a) + ' cd=' + getCooldown(c));
	}
	var buffs = TP_BUFF_CHIPS + STR_BUFF_CHIPS + MP_BUFF_CHIPS + OTHER_BUFF_CHIPS;
	buffs = arraySort(buffs, function(a, b) { return buffValue(b) - buffValue(a); });
	if (DBG_SUPPORT) for (var c in buffs) debug('buff ' + getChipName(c) + ' v=' + buffValue(c) + ' ready=' + chipReady(c));
	for (var c in buffs) buffAllies(c, allies);
	// 4. boucliers : l'allié de tête (le plus exposé), puis moi
	var exposed = count(allies) > 0 ? [allies[0]] : [];
	push(exposed, ME);
	for (var c in SHIELD_CHIPS) buffAllies(c, exposed);
	for (var c in RETURN_CHIPS) buffAllies(c, exposed);
	// 5. bulbes, attaque avec ce qui reste, soins restants
	summonBulbs();
	var plan = planAttack(getTP());
	if (plan != null) execute(plan);
	for (var c in HEAL_CHIPS) if (chipReady(c) && lifeRatio(hurt) < 0.9 && canUseChip(c, hurt)) useChip(c, hurt);
	// 6. se replier près du groupe
	cell = supportCell(fighters(), 1);
	if (cell != getCell()) moveTowardCell(cell);
}

// =====================================================================
//  Tour
// =====================================================================
if (isSupport()) {
	supportTurn();
} else {
	cleanseIfPoisoned();
	healSelf(0.4);
	resurrectAlly();

	var plan = planAttack(getTP());
	debug('T' + getTurn() + ' life=' + getLife() + ' tp=' + getTP() + ' mp=' + getMP() + ' str=' + getStrength() + ' plan=' + (plan == null ? 'null' : [plan[0], plan[1], getName(plan[2]), plan[3]]) + ' dmgTools=' + DMG_TOOLS);

	if (plan == null && count(MP_BUFF_CHIPS) > 0) {
		// personne à portée : bottes puis on recalcule
		// on simule d'abord : les bottes ne servent que si l'attaque en vaut la peine
		var ready = [];
		for (var c in MP_BUFF_CHIPS) if (chipReady(c)) push(ready, c);
		if (count(ready) > 0) {
			useChip(ready[0], ME);
			plan = planAttack(getTP());
			if (plan != null && plan[0] < BOOTS_MIN_SCORE) plan = null;
		}
	}

	if (plan != null) {
		IDLE = 0;
		// on peut taper ce tour : boosts PT d'abord, puis force si ça laisse de quoi frapper
		useBuffs(TP_BUFF_CHIPS);
		if (debuffTarget(plan[2])) plan = planAttack(getTP());
		if (plan == null) plan = planAttack(getTP());
		for (var c in STR_BUFF_CHIPS) {
			if (chipReady(c) && getTP() - getChipCost(c) >= 6) useChip(c, ME);
		}
		// jusqu'à 3 passes (si la cible meurt on retarget)
		for (var pass = 0; pass < 3 && plan != null && getTP() > 0; pass++) {
			execute(plan);
			plan = planAttack(getTP());
			if (plan != null && plan[1] != getCell() && getMP() == 0) plan = null;
		}
	} else {
		IDLE++;
		// rien à portée : on invoque, puis on se place à la limite de la zone de menace ennemie
		summonBulbs();
		position();
	}

	// PT restants
	healSelf(0.6);
	healAllies();
	if (enemyThreatens()) {
		useBuffs(SHIELD_CHIPS);
		useBuffs(RETURN_CHIPS);
		if (!hasEffect(ME, [EFFECT_RAW_BUFF_STRENGTH, EFFECT_BUFF_STRENGTH]))
			for (var c in STR_BUFF_CHIPS) if (chipReady(c)) { useChip(c, ME); break; }  // préparer le tour suivant
	}
	healSelf(0.9);
	summonBulbs();
	position();
}
debug('end tp=' + getTP() + ' mp=' + getMP() + ' cell=' + getCell());
